# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Airport reference ONLY. Set both in Vercel Preview, scoped to feature/supabase-auth.
# Use Flight Desk Test Project URL + Publishable Key, NOT its database DSN/password.
# Auth/profiles/flights continue using the existing NEXT_PUBLIC_SUPABASE_* above.
AIRPORTS_SUPABASE_URL=https://your-test-project-ref.supabase.co
AIRPORTS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-test-project-key
